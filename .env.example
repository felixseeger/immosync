# Copy this file to .env.local and fill in your actual values.
# .env.local is git-ignored and must never be committed.

# ─── Firebase Web App Config ───────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ─── Mapbox ────────────────────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJ5b3VyX3Rva2VuIn0.example

# ─── Resend (email via API routes) ────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ─── Firebase Admin SDK (server-side API routes only) ─────────────────────────
# Paste the content of your Firebase service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Optional: SMTP fallback ──────────────────────────────────────────────────
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@example.com
# EMAIL_PASSWORD=your_smtp_password

# ─── Optional: Gemini AI ──────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_key

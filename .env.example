# Copy to .env or .env.local and fill in values.

# Mapbox (required for map view and geocoding)
VITE_MAPBOX_TOKEN=

# Optional: Gemini API
GEMINI_API_KEY=

# Resend (welcome + password reset from /api/send-welcome, /api/send-password-reset). Server-side only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@immosync.felixseeger.de
# APP_URL used for links in emails (defaults to immosync.felixseeger.de if unset)
APP_URL=

# Firebase Admin (password reset link generation). Single-line JSON of your service account key.
# Project Settings → Service accounts → Generate new private key → paste minified JSON here.
FIREBASE_SERVICE_ACCOUNT_JSON=

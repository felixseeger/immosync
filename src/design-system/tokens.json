  "components": {
    "button": {
      "variants": ["primary", "secondary", "outline", "ghost", "danger"],
      "sizes": ["sm", "md", "lg", "xl"],
      "states": ["default", "hover", "active/pressed", "focus", "disabled", "loading"],
      "anatomy": ["container", "leftIcon?", "label", "rightIcon?", "spinner?"],
      "accessibility": {
        "role": "button",
        "keyboardSupport": ["Enter", "Space"],
        "ariaAttributes": ["aria-disabled", "aria-busy (loading)", "aria-label (icon-only)"]
      },
      "specs": {
        "primary":   { "bg": "#D9FF00", "text": "#0B1622", "hoverBg": "#C4E600", "radius": "6px" },
        "secondary": { "bg": "#162336", "text": "#FFFFFF", "hoverBg": "#1E2D40", "radius": "6px" },
        "outline":   { "bg": "transparent", "text": "#FFFFFF", "border": "#1E2D40", "hoverBg": "#162336", "radius": "6px" },
        "ghost":     { "bg": "transparent", "text": "#8899AA", "hoverBg": "rgba(217,255,0,0.06)", "hoverText": "#FFFFFF", "radius": "6px" },
        "danger":    { "bg": "#EF4444", "text": "#FFFFFF", "hoverBg": "#DC2626", "radius": "6px" }
      }
    },

    "input": {
      "variants": ["default", "with-icon-left", "with-icon-right", "with-prefix", "password"],
      "states": ["default", "focus", "filled", "error", "disabled", "read-only"],
      "anatomy": ["wrapper", "label", "inputContainer", "prefixIcon?", "inputField", "suffixIcon?", "helperText?", "errorText?"],
      "accessibility": {
        "associations": "label[for] matches input[id]",
        "ariaAttributes": ["aria-describedby (helper/error)", "aria-invalid (error state)", "aria-required"]
      },
      "specs": {
        "bg": "#0D1825", "border": "#1E2D40", "text": "#FFFFFF", "placeholder": "#4E6070",
        "focusBorder": "#D9FF00", "focusShadow": "0 0 0 3px rgba(217,255,0,0.15)",
        "errorBorder": "#EF4444", "disabledBg": "rgba(13,24,37,0.5)", "radius": "6px"
      }
    },

    "badge": {
      "variants": ["default", "success", "warning", "error", "info", "accent", "outline"],
      "sizes": ["sm", "md", "lg"],
      "anatomy": ["container", "dot?", "label"],
      "specs": {
        "radius": "4px",
        "fontWeight": "500",
        "textTransform": "none"
      }
    },

    "card": {
      "variants": ["default", "hover", "selected", "flat"],
      "anatomy": ["container", "header?", "media?", "body", "footer?", "actions?"],
      "specs": {
        "bg": "#111E2E", "border": "#1E2D40", "radius": "8px",
        "shadow": "0 1px 3px rgba(0,0,0,0.4)", "hoverShadow": "0 4px 12px rgba(0,0,0,0.5)",
        "padding": "20px 24px"
      }
    },

    "modal": {
      "sizes": ["sm", "md", "lg", "xl", "fullscreen"],
      "anatomy": ["overlay", "container", "header", "closeButton", "body", "footer"],
      "specs": {
        "widths": { "sm": "400px", "md": "560px", "lg": "720px", "xl": "900px" },
        "bg": "#111E2E", "radius": "12px", "shadow": "0 20px 48px rgba(0,0,0,0.7)"
      },
      "accessibility": {
        "role": "dialog",
        "ariaAttributes": ["aria-modal", "aria-labelledby", "aria-describedby"],
        "focus": "Trap focus within modal when open",
        "keyboard": ["Escape to close", "Tab cycling within modal"]
      }
    },

    "sidebar": {
      "anatomy": ["container", "logo", "navSection", "navItem (active/default)", "divider", "footerSection", "userProfile"],
      "specs": {
        "width": "240px", "bg": "#111E2E",
        "borderRight": "1px solid #1E2D40",
        "activeItemBg": "rgba(217,255,0,0.10)", "activeItemText": "#D9FF00",
        "activeIndicator": "3px left border #D9FF00",
        "defaultItemText": "#8899AA", "hoverItemBg": "rgba(255,255,255,0.04)"
      }
    },

    "table": {
      "anatomy": ["container", "toolbar", "headerRow", "headerCell", "dataRow", "dataCell", "footer", "pagination"],
      "states": ["default", "hover", "selected", "loading", "empty"],
      "specs": {

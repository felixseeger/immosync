      "black":    { "value": "#000000",   "description": "Pure black" },
      "white":    { "value": "#FFFFFF",   "description": "Pure white" },

      "navy": {
        "50":     { "value": "#E8EEF5",   "description": "Navy tint 50" },
        "100":    { "value": "#C5D3E0",   "description": "Navy tint 100" },
        "200":    { "value": "#8FAABB",   "description": "Navy tint 200" },
        "300":    { "value": "#5C7E96",   "description": "Navy tint 300" },
        "400":    { "value": "#3D5F78",   "description": "Navy tint 400" },
        "500":    { "value": "#2A4459",   "description": "Navy tint 500" },
        "600":    { "value": "#1E2D40",   "description": "Border / divider" },
        "700":    { "value": "#162336",   "description": "Elevated surface" },
        "800":    { "value": "#111E2E",   "description": "Card / panel surface" },
        "900":    { "value": "#0D1825",   "description": "Deep background" },
        "950":    { "value": "#0B1622",   "description": "Page background (base)" }
      },

      "lime": {
        "50":     { "value": "#F5FFB8",   "description": "Lime tint 50" },
        "100":    { "value": "#ECFF85",   "description": "Lime tint 100" },
        "200":    { "value": "#E2FF52",   "description": "Lime tint 200" },
        "300":    { "value": "#D9FF00",   "description": "Lime primary (brand)" },
        "400":    { "value": "#C4E600",   "description": "Lime hover" },
        "500":    { "value": "#AECB00",   "description": "Lime pressed / dark" },
        "600":    { "value": "#8FA600",   "description": "Lime deep" }
      },

      "green": {
        "400":    { "value": "#4ADE80",   "description": "Success light" },
        "500":    { "value": "#22C55E",   "description": "Success" },
        "600":    { "value": "#16A34A",   "description": "Success dark" },
        "bg":     { "value": "#0A2118",   "description": "Success bg tint" }
      },

      "amber": {
        "400":    { "value": "#FCD34D",   "description": "Warning light" },
        "500":    { "value": "#F59E0B",   "description": "Warning" },
        "600":    { "value": "#D97706",   "description": "Warning dark" },
        "bg":     { "value": "#221A06",   "description": "Warning bg tint" }
      },

      "red": {
        "400":    { "value": "#F87171",   "description": "Error light" },
        "500":    { "value": "#EF4444",   "description": "Error" },
        "600":    { "value": "#DC2626",   "description": "Error dark" },
        "bg":     { "value": "#220A0A",   "description": "Error bg tint" }
      },

      "blue": {
        "400":    { "value": "#60A5FA",   "description": "Info light" },
        "500":    { "value": "#3B82F6",   "description": "Info" },
        "600":    { "value": "#2563EB",   "description": "Info dark" },
        "bg":     { "value": "#091526",   "description": "Info bg tint" }
      },

      "violet": {
        "500":    { "value": "#8B5CF6",   "description": "Purple accent" },
        "bg":     { "value": "#150F26",   "description": "Purple bg tint" }
      },

      "orange": {
        "500":    { "value": "#F97316",   "description": "Orange accent" },
        "bg":     { "value": "#221208",   "description": "Orange bg tint" }
      }
    },

    "semantic": {
      "background": {
        "base":         { "value": "{color.base.navy.950}",   "description": "Page / root background" },
        "surface":      { "value": "{color.base.navy.800}",   "description": "Cards, panels, sidebar" },
        "elevated":     { "value": "{color.base.navy.700}",   "description": "Modals, popovers, dropdowns" },
        "overlay":      { "value": "rgba(0,0,0,0.65)",        "description": "Modal / drawer dim overlay" },
        "input":        { "value": "{color.base.navy.900}",   "description": "Form input backgrounds" },
        "tooltip":      { "value": "#1A2A3E",                 "description": "Tooltip background" },
        "hover":        { "value": "rgba(217,255,0,0.06)",    "description": "Interactive hover state" },
        "selected":     { "value": "rgba(217,255,0,0.10)",    "description": "Selected / active state" },
        "disabled":     { "value": "rgba(11,22,34,0.5)",      "description": "Disabled element bg" }
      },

      "foreground": {
        "primary":      { "value": "{color.base.white}",       "description": "Primary text, headings" },
        "secondary":    { "value": "#8899AA",                  "description": "Supporting text, labels" },
        "muted":        { "value": "#4E6070",                  "description": "Placeholder, disabled text" },
        "inverted":     { "value": "{color.base.navy.950}",    "description": "Text on accent/lime surfaces" },
        "link":         { "value": "{color.base.lime.300}",    "description": "Hyperlinks" },
        "link-hover":   { "value": "{color.base.lime.200}",    "description": "Hovered hyperlinks" }
      },

      "border": {
        "default":      { "value": "{color.base.navy.600}",   "description": "Default border / divider" },
        "subtle":       { "value": "#152030",                  "description": "Subtle / inner borders" },
        "focus":        { "value": "{color.base.lime.300}",   "description": "Focus ring border" },
        "error":        { "value": "{color.base.red.500}",    "description": "Error state border" },
        "success":      { "value": "{color.base.green.500}",  "description": "Success state border" }
      },

      "accent": {
        "default":      { "value": "{color.base.lime.300}",   "description": "Primary brand accent (lime)" },
        "hover":        { "value": "{color.base.lime.400}",   "description": "Accent hover state" },
        "pressed":      { "value": "{color.base.lime.500}",   "description": "Accent pressed state" },
        "muted":        { "value": "rgba(217,255,0,0.12)",    "description": "Muted accent bg tint" },
        "foreground":   { "value": "{color.base.navy.950}",   "description": "Text on accent background" }
      },

      "status": {
        "success":      { "value": "{color.base.green.500}",  "description": "Success indicator" },
        "success-bg":   { "value": "{color.base.green.bg}",   "description": "Success background tint" },
        "success-fg":   { "value": "{color.base.green.400}",  "description": "Success text / icon" },
        "warning":      { "value": "{color.base.amber.500}",  "description": "Warning indicator" },
        "warning-bg":   { "value": "{color.base.amber.bg}",   "description": "Warning background tint" },
        "warning-fg":   { "value": "{color.base.amber.400}",  "description": "Warning text / icon" },
        "error":        { "value": "{color.base.red.500}",    "description": "Error / danger indicator" },
        "error-bg":     { "value": "{color.base.red.bg}",     "description": "Error background tint" },
        "error-fg":     { "value": "{color.base.red.400}",    "description": "Error text / icon" },
        "info":         { "value": "{color.base.blue.500}",   "description": "Informational indicator" },
        "info-bg":      { "value": "{color.base.blue.bg}",    "description": "Info background tint" },
        "info-fg":      { "value": "{color.base.blue.400}",   "description": "Info text / icon" },
        "neutral":      { "value": "#4E6070",                 "description": "Neutral / default state" },
        "neutral-bg":   { "value": "rgba(78,96,112,0.15)",   "description": "Neutral background tint" },
        "neutral-fg":   { "value": "#8899AA",                 "description": "Neutral text" }
      },

      "deal-stage": {
        "prospect":     { "value": "{color.base.blue.500}",    "description": "Prospect stage" },
        "active":       { "value": "{color.base.lime.300}",    "description": "Active/engaged stage" },
        "offer":        { "value": "{color.base.amber.500}",   "description": "Offer made stage" },
        "negotiation":  { "value": "{color.base.violet.500}",  "description": "Negotiation stage" },
        "closed-won":   { "value": "{color.base.green.500}",   "description": "Closed won" },
        "closed-lost":  { "value": "{color.base.red.500}",     "description": "Closed lost" }
      },

      "property-type": {
        "apartment":    { "value": "{color.base.blue.500}",    "description": "Apartment type" },
        "house":        { "value": "{color.base.green.500}",   "description": "House type" },
        "commercial":   { "value": "{color.base.orange.500}",  "description": "Commercial type" },
        "land":         { "value": "{color.base.amber.500}",   "description": "Land / plot type" },
        "villa":        { "value": "{color.base.violet.500}",  "description": "Villa / luxury type" }
      }
    },

    "contrast": {
      "note": "All text combinations meet WCAG 2.1 AA (4.5:1 for normal text, 3:1 for large text)",
      "pairs": [
        { "fg": "#FFFFFF",  "bg": "#0B1622", "ratio": "14.8:1", "level": "AAA" },
        { "fg": "#8899AA",  "bg": "#0B1622", "ratio": "5.1:1",  "level": "AA"  },
        { "fg": "#D9FF00",  "bg": "#0B1622", "ratio": "12.6:1", "level": "AAA" },
        { "fg": "#0B1622",  "bg": "#D9FF00", "ratio": "12.6:1", "level": "AAA" },
        { "fg": "#FFFFFF",  "bg": "#111E2E", "ratio": "12.2:1", "level": "AAA" },
        { "fg": "#8899AA",  "bg": "#111E2E", "ratio": "4.2:1",  "level": "AA (large)" },
        { "fg": "#22C55E",  "bg": "#0B1622", "ratio": "6.4:1",  "level": "AA"  },
        { "fg": "#F59E0B",  "bg": "#0B1622", "ratio": "7.8:1",  "level": "AA"  },
        { "fg": "#EF4444",  "bg": "#0B1622", "ratio": "5.2:1",  "level": "AA"  },
        { "fg": "#3B82F6",  "bg": "#0B1622", "ratio": "4.8:1",  "level": "AA"  }
      ]
    }
  },

  "typography": {
    "fontFamily": {
      "primary":    { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "description": "Primary UI font — all text" },
      "mono":       { "value": "'JetBrains Mono', 'Fira Code', 'Consolas', monospace", "description": "Monospace — code, IDs, technical values" }
    },

    "fontSize": {
      "2xs":  { "value": "10px",  "lineHeight": "1.4", "description": "Extra extra small — timestamps, sub-labels" },
      "xs":   { "value": "11px",  "lineHeight": "1.4", "description": "Extra small — captions, footnotes" },
      "sm":   { "value": "12px",  "lineHeight": "1.5", "description": "Small — labels, badges, table cells" },
      "base": { "value": "13px",  "lineHeight": "1.5", "description": "Base — body text, input values" },
      "md":   { "value": "14px",  "lineHeight": "1.5", "description": "Medium — secondary headings, prominent body" },
      "lg":   { "value": "16px",  "lineHeight": "1.4", "description": "Large — card titles, form labels" },
      "xl":   { "value": "18px",  "lineHeight": "1.35","description": "XL — section titles, dialog headers" },
      "2xl":  { "value": "20px",  "lineHeight": "1.3", "description": "2XL — page sub-headings" },
      "3xl":  { "value": "24px",  "lineHeight": "1.25","description": "3XL — page titles, metric values" },
      "4xl":  { "value": "28px",  "lineHeight": "1.2", "description": "4XL — hero metrics, key stats" },
      "5xl":  { "value": "32px",  "lineHeight": "1.15","description": "5XL — large display numbers" },
      "6xl":  { "value": "40px",  "lineHeight": "1.1", "description": "6XL — landing hero headings" },
      "7xl":  { "value": "48px",  "lineHeight": "1.05","description": "7XL — marketing display" }
    },

    "fontWeight": {
      "regular":    { "value": "400", "description": "Regular — body, descriptions" },
      "medium":     { "value": "500", "description": "Medium — labels, active nav, captions" },
      "semibold":   { "value": "600", "description": "Semibold — headings, card titles, buttons" },
      "bold":       { "value": "700", "description": "Bold — display metrics, stat highlights" },
      "extrabold":  { "value": "800", "description": "Extra bold — hero display only" }
    },

    "letterSpacing": {
      "tight":      { "value": "-0.02em", "description": "Large display headings" },
      "normal":     { "value": "0",       "description": "Default" },
      "wide":       { "value": "0.02em",  "description": "Labels, uppercased small text" },
      "wider":      { "value": "0.05em",  "description": "Tracking for all-caps labels" },
      "widest":     { "value": "0.1em",   "description": "Logo, brand mark" }
    },

    "scale": {
      "display-2xl": { "size": "48px", "weight": "700", "lineHeight": "1.05", "letterSpacing": "-0.02em", "usage": "Marketing hero — landing pages only" },
      "display-xl":  { "size": "40px", "weight": "700", "lineHeight": "1.1",  "letterSpacing": "-0.02em", "usage": "Large hero headings" },
      "display-lg":  { "size": "32px", "weight": "700", "lineHeight": "1.15", "letterSpacing": "-0.01em", "usage": "KPI / metric display values" },
      "display-md":  { "size": "28px", "weight": "600", "lineHeight": "1.2",  "letterSpacing": "-0.01em", "usage": "Dashboard stat numbers" },
      "heading-xl":  { "size": "24px", "weight": "600", "lineHeight": "1.25", "letterSpacing": "0",       "usage": "Page titles, modal headers" },
      "heading-lg":  { "size": "20px", "weight": "600", "lineHeight": "1.3",  "letterSpacing": "0",       "usage": "Section headings, card group titles" },
      "heading-md":  { "size": "18px", "weight": "600", "lineHeight": "1.35", "letterSpacing": "0",       "usage": "Card titles, dialog titles" },
      "heading-sm":  { "size": "16px", "weight": "600", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Form group labels, sub-section titles" },
      "heading-xs":  { "size": "14px", "weight": "600", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Table column headers, emphasized labels" },
      "body-lg":     { "size": "16px", "weight": "400", "lineHeight": "1.6",  "letterSpacing": "0",       "usage": "Prominent body text, lead paragraphs" },
      "body-md":     { "size": "14px", "weight": "400", "lineHeight": "1.6",  "letterSpacing": "0",       "usage": "Standard body copy, descriptions" },
      "body-sm":     { "size": "13px", "weight": "400", "lineHeight": "1.5",  "letterSpacing": "0",       "usage": "Secondary body, card descriptions" },
      "label-lg":    { "size": "14px", "weight": "500", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Form labels, prominent UI labels" },
      "label-md":    { "size": "13px", "weight": "500", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Standard UI labels, nav items" },
      "label-sm":    { "size": "12px", "weight": "500", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Small labels, tag text" },
      "caption":     { "size": "12px", "weight": "400", "lineHeight": "1.4",  "letterSpacing": "0",       "usage": "Helper text, timestamps, metadata" },
      "caption-xs":  { "size": "11px", "weight": "400", "lineHeight": "1.4",  "letterSpacing": "0.02em",  "usage": "Footnotes, extra-small captions" },
      "overline":    { "size": "11px", "weight": "600", "lineHeight": "1.4",  "letterSpacing": "0.08em",  "usage": "Section labels ALL-CAPS above content" },
      "code":        { "size": "13px", "weight": "400", "lineHeight": "1.6",  "letterSpacing": "0",       "fontFamily": "mono", "usage": "Code snippets, IDs, technical strings" }
    },

    "responsive": {
      "note": "Type scales down on smaller viewports",
      "breakpoints": {
        "sm":  "640px",
        "md":  "768px",
        "lg":  "1024px",
        "xl":  "1280px",
        "2xl": "1440px"
      },
      "rules": [
        { "token": "display-2xl", "base": "48px", "md": "40px", "sm": "32px" },
        { "token": "display-xl",  "base": "40px", "md": "32px", "sm": "28px" },
        { "token": "heading-xl",  "base": "24px", "md": "20px", "sm": "18px" },
        { "token": "heading-lg",  "base": "20px", "md": "18px", "sm": "16px" }
      ]
    }
  },

  "spacing": {
    "base": { "value": "8px", "description": "Base unit — all spacing is a multiple of 8 (with 4px half-step)" },
    "scale": {
      "0":    { "value": "0px",   "description": "Zero" },
      "px":   { "value": "1px",   "description": "Single pixel — borders, hairlines" },
      "0.5":  { "value": "2px",   "description": "Micro — focus ring offset, separator margin" },
      "1":    { "value": "4px",   "description": "Tiny — icon-to-text gap, tight badge padding" },
      "1.5":  { "value": "6px",   "description": "Extra small — tag padding vertical" },
      "2":    { "value": "8px",   "description": "Small — button icon gap, cell padding tight" },
      "2.5":  { "value": "10px",  "description": "Small+ — button padding vertical" },
      "3":    { "value": "12px",  "description": "Medium-small — sidebar item padding, small card gap" },
      "4":    { "value": "16px",  "description": "Medium — standard gap, card padding tight" },
      "5":    { "value": "20px",  "description": "Medium+ — form group gap" },
      "6":    { "value": "24px",  "description": "Large — card padding, section gap small" },
      "7":    { "value": "28px",  "description": "Large+ — modal padding" },
      "8":    { "value": "32px",  "description": "XL — page horizontal padding, major gaps" },
      "10":   { "value": "40px",  "description": "2XL — section gaps" },
      "12":   { "value": "48px",  "description": "3XL — hero section padding" },
      "16":   { "value": "64px",  "description": "4XL — large section padding" },
      "20":   { "value": "80px",  "description": "5XL — page-level vertical rhythm" },
      "24":   { "value": "96px",  "description": "6XL — large layout gaps" }
    },

    "component": {
      "button": {
        "sm":   { "padding": "6px 12px",  "height": "30px", "fontSize": "12px", "iconSize": "14px" },
        "md":   { "padding": "8px 16px",  "height": "36px", "fontSize": "13px", "iconSize": "16px" },
        "lg":   { "padding": "10px 20px", "height": "42px", "fontSize": "14px", "iconSize": "18px" },
        "xl":   { "padding": "12px 24px", "height": "48px", "fontSize": "16px", "iconSize": "20px" }
      },
      "input": {
        "sm":   { "padding": "6px 10px",  "height": "30px", "fontSize": "12px" },
        "md":   { "padding": "8px 12px",  "height": "38px", "fontSize": "13px" },
        "lg":   { "padding": "10px 14px", "height": "44px", "fontSize": "14px" }
      },
      "badge": {
        "sm":   { "padding": "2px 6px",   "height": "18px", "fontSize": "10px" },
        "md":   { "padding": "3px 8px",   "height": "22px", "fontSize": "11px" },
        "lg":   { "padding": "4px 10px",  "height": "26px", "fontSize": "12px" }
      }
    }
  },

  "grid": {
    "columns": { "value": "12", "description": "12-column grid" },
    "gutter":  { "value": "24px", "description": "Column gutter (gap between columns)" },
    "margin":  {
      "sm":    { "value": "16px",  "description": "Mobile outer margin" },
      "md":    { "value": "24px",  "description": "Tablet outer margin" },
      "lg":    { "value": "32px",  "description": "Desktop outer margin" },
      "xl":    { "value": "48px",  "description": "Wide desktop outer margin" }
    },
    "maxWidth": { "value": "1440px", "description": "Max content width" },
    "breakpoints": {
      "sm":    { "value": "640px",  "columns": 4, "gutter": "16px" },
      "md":    { "value": "768px",  "columns": 8, "gutter": "20px" },
      "lg":    { "value": "1024px", "columns": 12, "gutter": "24px" },
      "xl":    { "value": "1280px", "columns": 12, "gutter": "24px" },
      "2xl":   { "value": "1440px", "columns": 12, "gutter": "24px" }
    },
    "columnSpans": {
      "sidebar":     { "value": "2/12",  "px": "240px",      "description": "Navigation sidebar" },
      "main":        { "value": "10/12", "description": "Main content area alongside sidebar" },
      "narrow":      { "value": "4/12",  "description": "Narrow column (1/3 of grid)" },
      "half":        { "value": "6/12",  "description": "Half width column" },
      "wide":        { "value": "8/12",  "description": "Wide column (2/3 of grid)" },
      "full":        { "value": "12/12", "description": "Full width" },
      "card-sm":     { "value": "3/12",  "description": "Small card (4 per row)" },
      "card-md":     { "value": "4/12",  "description": "Medium card (3 per row)" },
      "card-lg":     { "value": "6/12",  "description": "Large card (2 per row)" }
    }
  },

  "borderRadius": {
    "none":   { "value": "0px",    "description": "No radius — tables, flush containers" },
    "sm":     { "value": "4px",    "description": "Small — badges, tags, small chips" },
    "md":     { "value": "6px",    "description": "Medium — buttons, inputs, small cards" },
    "lg":     { "value": "8px",    "description": "Large — cards, panels" },
    "xl":     { "value": "12px",   "description": "XL — modals, drawers" },
    "2xl":    { "value": "16px",   "description": "2XL — large containers" },
    "full":   { "value": "9999px", "description": "Pill — pill buttons, avatars, full-round badges" }
  },

  "shadow": {
    "sm":     { "value": "0 1px 3px rgba(0,0,0,0.4), 0 1px 2px rgba(0,0,0,0.3)",               "description": "Subtle — inputs, small cards" },
    "md":     { "value": "0 4px 12px rgba(0,0,0,0.5), 0 2px 6px rgba(0,0,0,0.3)",              "description": "Medium — cards, buttons" },
    "lg":     { "value": "0 8px 24px rgba(0,0,0,0.6), 0 4px 12px rgba(0,0,0,0.4)",             "description": "Large — modals, popovers" },
    "xl":     { "value": "0 20px 48px rgba(0,0,0,0.7), 0 8px 24px rgba(0,0,0,0.5)",            "description": "XL — sideover panels" },
    "accent": { "value": "0 0 0 3px rgba(217,255,0,0.25)",                                      "description": "Focus ring / accent glow" },
    "inner":  { "value": "inset 0 2px 4px rgba(0,0,0,0.4)",                                    "description": "Inner shadow — pressed states, inputs" }
  },

  "border": {
    "width": {
      "thin":     { "value": "1px",  "description": "Standard border" },
      "medium":   { "value": "2px",  "description": "Focus ring, active indicator" },
      "thick":    { "value": "3px",  "description": "Accent borders, sidebar active indicator" }
    },
    "style": {

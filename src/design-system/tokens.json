{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "ImmoSync Design System",
    "version": "1.0.0",
    "description": "Production-ready design tokens for ImmoSync Real Estate CRM",
    "author": "ImmoSync Design Team",
    "lastUpdated": "2026-03-10",
    "principles": [
      "Clarity First — every UI element serves a purpose",
      "Data Forward — property and deal data are always legible",
      "Dark by Default — optimized for extended professional use",
      "Accessible Always — WCAG 2.1 AA minimum contrast throughout"
    ]
  },

  "color": {
